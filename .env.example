# ---------------------------------------------------------------------------
# aether-eoc-reference — example environment
#
# Copy to .env for local runs:   cp .env.example .env
# The demo is fully functional with these defaults and NO API keys.
# Never commit a real .env (see .gitignore).
# ---------------------------------------------------------------------------

# Marks the deployment as a synthetic demo. Drives the SYNTHETIC DEMO banner
# and enables the seeded demo operators. Must be false in any real deployment.
DEMO_MODE=true

# SQLite is the zero-ops default (ADR-0002). Postgres is optional:
#   DATABASE_URL=postgresql+asyncpg://eoc:eoc@localhost:5432/eoc
DATABASE_URL=sqlite+aiosqlite:///./data/eoc.db

# LLM is an ENHANCEMENT, not a gate. With LLM_PROVIDER=none the agents run in
# deterministic fixture mode and every demo step still works offline.
# none | openai | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# none | openai. When none, retrieval uses BM25 lexical ranking only.
EMBEDDING_PROVIDER=none

# Demo-only signing secret. Regenerated per-process if left blank.
# A real deployment must supply a managed secret and rotate it.
DEMO_JWT_SECRET=

# Where the browser reaches the API. Compose overrides this for the web service.
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_WS_BASE=ws://localhost:8080
